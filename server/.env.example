# =============================================================================
# CMS Platform — Backend Environment Configuration (.env)
# Copy this file to .env in the server/ directory
# =============================================================================

NODE_ENV=development
PORT=3001

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://cms:cms_dev_password@localhost:5432/cms_platform

# MariaDB
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=cms
MARIADB_PASSWORD=cms_dev_password
MARIADB_DATABASE=cms_platform

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=cms
MYSQL_PASSWORD=cms_dev_password
MYSQL_DATABASE=cms_platform

# CockroachDB
COCKROACH_HOST=localhost
COCKROACH_PORT=26257
COCKROACH_USER=root
COCKROACH_DATABASE=cms_platform

# MongoDB
MONGO_URI=mongodb://cms:cms_dev_password@localhost:27017/cms_platform?authSource=admin

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cms_platform

# Active database engine: postgres | mariadb | mysql | cockroach | mongodb | clickhouse
ACTIVE_DATABASE=postgres

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters-long

COOKIE_SECURE=false
