{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^@nestjs/(common|core|platform-express|testing)(.*)$": "<rootDir>/../node_modules/@nestjs/$1$2"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
