# =============================================================================
# CMS Platform — Environment Configuration (copy to server/.env)
# NEVER commit real secrets. Use strong values in production.
# =============================================================================

NODE_ENV=development
PORT=3001

# Frontend origin (CORS)
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://cms:cms_dev_password@localhost:5432/cms_platform

# MongoDB
MONGO_URI=mongodb://cms:cms_dev_password@localhost:27017/cms_platform?authSource=admin

# Active database: postgres | mongodb
ACTIVE_DATABASE=postgres

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-32-characters-long

# Cookie security. In NODE_ENV=production cookies are ALWAYS Secure (and use the
# __Host- prefix) regardless of this flag. Set COOKIE_SECURE=true when running
# development behind HTTPS (e.g. ngrok) so cookies still get the Secure attribute.
COOKIE_SECURE=false
